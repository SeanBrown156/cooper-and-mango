# Godot 4
.godot/
*.import
export_presets.cfg
*.translation

# macOS
.DS_Store

# Editor
.vscode/
*.swp

# Raw reference material (photos, Ableton projects, PixelLab exports, sketches).
# Folder structure (the reference photo drop zone, see docs/ART_BIBLE.md) is
# tracked via .gitkeep; actual media files are excluded until the Git LFS
# decision is made (see docs/PRODUCTION_ROADMAP.md).
# 2026-08-13: moved out of assets/ into raw/ (see CLAUDE.md's "Where things live").
raw/reference/**
!raw/reference/**/
!raw/reference/**/.gitkeep
!raw/reference/.gdignore

# Large third-party asset packs, pending the same Git LFS decision above.
# Provenance/license terms are recorded in docs/ASSET_LICENSES.md regardless
# of whether the raw files are committed. The two packs already wired into
# the Tutorial Room (rgsdev, bitglow) predate this rule and stay tracked as
# before — this only stops new large packs from being added uncompressed.
# 2026-08-13: unified from assets/environments/thirdparty/ + assets/characters/thirdparty/
# into one assets/thirdparty/ (see CLAUDE.md's "Where things live").
assets/thirdparty/0x72_industrial_tileset/
assets/thirdparty/kenney_ui_pack/
assets/thirdparty/kenney_fantasy_ui_borders/
assets/thirdparty/limezu_modern_exteriors/
assets/thirdparty/limezu_modern_interiors_full/
assets/thirdparty/limezu_serene_village/
assets/thirdparty/superretroworld_interior_pack/

# Agent scratch output, not meant to be permanent
.scratch/
